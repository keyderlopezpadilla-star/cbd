# ============================================
# CBD SaaS Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbdsaas"

# Authentication (NextAuth.js)
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Redis (optional, for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GreenLeaf CBD"

# CSRF Protection
CSRF_SECRET="your-csrf-secret-generate-with-openssl-rand-base64-32"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@greenleafcbd.es"

# Storage (for file uploads)
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# AI Features (optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"
AI_MAX_TOKENS="2000"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""

# Payments (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Note: VERCEL_ORG_ID and VERCEL_PROJECT_ID are system variables
# injected automatically by Vercel. Do NOT set them manually.
