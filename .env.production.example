# ============================================
# CBD SaaS Platform - Vercel Production Environment Variables
# ============================================
# Set these in the Vercel Dashboard under Project Settings > Environment Variables
# https://vercel.com/docs/projects/environment-variables

# ============================================
# REQUIRED - Database (Vercel Postgres or External)
# ============================================
# If using Vercel Postgres, these are auto-populated when you link the database.
# If using an external PostgreSQL provider (Supabase, Neon, Railway, etc.):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ============================================
# REQUIRED - Authentication
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
# Set to your production domain (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"

# ============================================
# REQUIRED - Application
# ============================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="GreenLeaf CBD"

# ============================================
# REQUIRED - Security
# ============================================
# Generate with: openssl rand -base64 32
CSRF_SECRET="generate-a-secure-random-string-here"
ALLOWED_ORIGINS="https://your-app.vercel.app"

# ============================================
# OPTIONAL - Redis (for caching and rate limiting)
# ============================================
# Use Vercel KV or external Redis provider (Upstash recommended for serverless)
# REDIS_URL="redis://default:password@host:6379"

# ============================================
# OPTIONAL - Email (for notifications)
# ============================================
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASSWORD="re_xxxxx"
# SMTP_FROM="noreply@yourdomain.com"

# ============================================
# OPTIONAL - Storage (for file uploads)
# ============================================
# STORAGE_PROVIDER="s3"
# S3_BUCKET="your-bucket-name"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="AKIA..."
# S3_SECRET_KEY="your-secret-key"

# ============================================
# OPTIONAL - AI Features
# ============================================
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4"
# AI_MAX_TOKENS="2000"

# ============================================
# OPTIONAL - Analytics
# ============================================
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."

# ============================================
# OPTIONAL - Payments
# ============================================
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
